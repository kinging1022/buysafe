# Copy to backend/.env (git-ignored) and fill in.
# 'fake' accepts 000000 and sends nothing; 'termii' sends real SMS.
OTP_SERVICE=fake
TERMII_API_KEY=
# Your account's base URL from the Termii dashboard, e.g. https://XXXX.api.termii.com
TERMII_BASE_URL=
TERMII_SENDER_ID=
# 'dnd' (reaches DND numbers; needs approval) or 'generic'
TERMII_CHANNEL=dnd
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
