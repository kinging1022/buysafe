# Copy to backend/.env (git-ignored) and fill in.
# 'fake' accepts 000000 and sends nothing; 'termii' sends real SMS.
OTP_SERVICE=fake
TERMII_API_KEY=
# Your account's base URL from the Termii dashboard, e.g. https://XXXX.api.termii.com
TERMII_BASE_URL=
TERMII_SENDER_ID=
# 'dnd' (reaches DND numbers; needs approval) or 'generic'
TERMII_CHANNEL=dnd
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Offers expire this many minutes after they're sent (default 48h). Shorten to test.
# OFFER_TTL_MINUTES=2880
# Accepted offers: how long the price is held for the buyer (hours).
# OFFER_PRICE_HOLD_HOURS=24

# --- Payments (bank transfer into a per-deal virtual account) ---
# 'fake' in dev/tests; 'anchor' in production (Pay with Transfer is production-only at Anchor).
PAYMENTS_PROVIDER=fake
# Webhook signing secret (the fake provider signs with HMAC-SHA256).
PAYMENTS_WEBHOOK_SECRET=dev-webhook-secret
# Minutes a buyer has to send the transfer (the listing is held meanwhile).
# PAYMENT_HOLD_MINUTES=30
# Deducted from refunds the buyer caused (wrong amount), whole naira. [BANK FEE] in the UI.
REFUND_BANK_FEE=0
# Hosts Django answers to (comma-separated). In dev, add .trycloudflare.com for a webhook tunnel.
# ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
# Anchor. Webhook URL: https://<api host>/api/payments/webhooks/anchor/ (create it with supportIncluded=true).
# ANCHOR_BASE_URL=https://api.getanchor.co
ANCHOR_API_KEY=
ANCHOR_WEBHOOK_SECRET=
# Deposit account refunds and payouts are sent from (…-anc_acc).
ANCHOR_ACCOUNT_ID=
# Revenue deposit account our fee is moved to once a payout arrives (…-anc_acc).
ANCHOR_REVENUE_ACCOUNT_ID=
# Email for the virtual account when the buyer has none.
ANCHOR_CUSTOMER_EMAIL=
# ANCHOR_REFERENCE_PREFIX=bs
# 'nuban' against the sandbox (ANCHOR_BASE_URL=https://api.sandbox.getanchor.co); production keeps the default.
# ANCHOR_COLLECT=paywithtransfer
# Fake name enquiry: this name for any account (numbers ending 8 = a stranger, 9 = bank unreachable).
# FAKE_ACCOUNT_NAME=ADEYEMI TOLU OLUWASEUN
# Fernet key for bank account numbers. Required in production:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Deal videos and chat photos (never public).
# PRIVATE_MEDIA_ROOT=/var/lib/buysafe/private_media
# Automated reminder calls: 'fake' logs them ('termii' isn't wired: confirm the voice API first).
CALL_SERVICE=fake

# --- Celery (sweeps, retries, reconciliation) ---
REDIS_URL=redis://localhost:6379/0
# 1 = run tasks inline (dev default). Set 0 with a worker + beat running.
# CELERY_EAGER=1
# Reconciliation mismatches and failed transfers are emailed here: "Name:email,Name:email"
ADMINS=
