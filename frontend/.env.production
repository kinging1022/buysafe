# Production builds (`npm run build`). See README, "Pre-launch mode".

# The go-live switch. true: only the pre-launch waitlist page at / (plus
# /login and /reset-password for staff); every other URL redirects to /.
# Set to false (or delete) at launch to serve the full site.
VITE_PRELAUNCH=true

# Pre-launch footer links. Leave empty to hide a link.
VITE_CONTACT_EMAIL=
VITE_INSTAGRAM_HANDLE=
